# Build from the project root (the parent of deploy/):
#   podman build -f deploy/Containerfile -t localhost/heal-loop:0.1.0 .
# Both stages start from the same Python image, pinned by digest, so the virtualenv made in the
# build stage runs unchanged in the final stage.
ARG PYTHON=docker.io/library/python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df

FROM ghcr.io/astral-sh/uv:0.12.24@sha256:3af4716e991d6956a41e573eab705d0ee08500cd829ed30293eb8472f372c65a AS uv

# Stage 1: build. uv lives only here.
FROM ${PYTHON} AS build
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
# --frozen: install exactly what uv.lock says. --no-dev: no pytest, ruff or mypy.
# --no-editable: copy the package into the virtualenv, so the final stage does not need src/.
RUN UV_PYTHON_DOWNLOADS=never uv sync --frozen --no-dev --no-editable --compile-bytecode

# Stage 2: runtime. No uv, no pip, no compiler. git is here because the loop uses git worktrees.
FROM ${PYTHON}
RUN pip uninstall --yes pip \
 && apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 heal \
 && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /work --shell /usr/sbin/nologin heal
COPY --from=build /app/.venv /app/.venv
# The root file system is read-only at run time. /work is the one writable path and must be a mounted volume.
# PYTHONDONTWRITEBYTECODE stops Python trying to write .pyc files next to the code.
ENV PATH=/app/.venv/bin:$PATH \
    HOME=/work \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /work
USER 10001:10001
ENTRYPOINT ["heal-loop"]
